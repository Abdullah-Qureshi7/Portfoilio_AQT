# =========================
# Resend (contact form email)
# =========================
# Get a key from https://resend.com
# Vercel → Project → Settings → Environment Variables
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# =========================
# OpenRouter (portfolio chat AI) — OPTIONAL
# =========================
# Chat works WITHOUT this key (local answers from portfolio data).
# Add these on Vercel when you want smarter AI replies:
#
#   Name:  OPENROUTER_API_KEY
#   Value: sk-or-v1-...   (paste your full key, no quotes/spaces)
#   Env:   Production (and Preview if you want)
#
# After saving on Vercel, Redeploy the project once.
#
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o-mini

# Your live site URL (helps OpenRouter; optional)
# Example: https://abdullahqureshitalks.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
