# Get a key from https://resend.com
# Add the same variable in Vercel → Project → Settings → Environment Variables
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Optional: portfolio chatbot AI (OpenRouter)
# Without this key, chatbot still works using local portfolio knowledge
OPENROUTER_API_KEY=sk-or-xxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o-mini
NEXT_PUBLIC_SITE_URL=http://localhost:3000
